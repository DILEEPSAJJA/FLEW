# ==============================================================================
# FLEW — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# MSG91 Official OTP Widget & Server-Side Verification Credentials
# ------------------------------------------------------------------------------
# SECRET: Never expose MSG91_AUTH_KEY to client-side code or browser bundles.
# Obtain your Auth Key from MSG91 Dashboard > Settings > API Keys.
MSG91_AUTH_KEY=your_msg91_auth_key_here

# MSG91 OTP Widget Configuration
# Obtain Widget ID from MSG91 Dashboard > OTP Widget.
MSG91_WIDGET_ID=336662446c64373435303732
MSG91_TOKEN_AUTH=your_widget_token_auth_if_configured

# Client-side exposed variables (Prefix with VITE_ for Vite bundler)
VITE_MSG91_WIDGET_ID=336662446c64373435303732
VITE_MSG91_TOKEN_AUTH=your_widget_token_auth_if_configured

# ------------------------------------------------------------------------------
# Store Staff & Admin Portal Security
# ------------------------------------------------------------------------------
# 6-digit access PIN required to enter /#admin portal (Default: 123789)
ADMIN_PIN=123789

# ------------------------------------------------------------------------------
# Server Session & Security
# ------------------------------------------------------------------------------
SESSION_SECRET=flew_super_secret_cat_session_signing_key_2026
DATA_DIR=data
